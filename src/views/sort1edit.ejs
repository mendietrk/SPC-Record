<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<title>Editar medición</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

</head>

<body class="container mt-5">

<h3>Editar medición</h3>

<hr>

<form action="/update1/<%= medicion._id %>" method="POST">

<input
type="hidden"
name="campo"
value="<%= campo %>">

<div class="mb-3">

<label class="form-label">

Número de parte

</label>

<input
class="form-control"
value="<%= medicion.numeroParte %>"
readonly>

</div>


<div class="mb-3">

<label class="form-label">

Fecha

</label>

<input
class="form-control"
value="<%= new Date(medicion.timestamp).toLocaleString() %>"
readonly>

</div>


<div class="mb-3">

<label class="form-label">

Característica

</label>

<input
class="form-control"
value="<%= campo %>"
readonly>

</div>


<div class="mb-3">

<label class="form-label">

Valor

</label>

<input

type="number"

step="any"

name="valor"

class="form-control"

value="<%= valor %>"

required>

</div>


<button class="btn btn-success">

Guardar

</button>

<a href="/sort1" class="btn btn-secondary">

Cancelar

</a>

</form>

</body>

</html>