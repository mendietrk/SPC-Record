<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Ordenar Mediciones</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        body{
            background:#f4f6f9;
        }

        .card{
            margin-top:25px;
            box-shadow:0px 2px 10px rgba(0,0,0,.15);
        }

        .spinner{
            display:none;
        }

    </style>

</head>

<body>

<div class="container">

<div class="card">

<div class="card-header bg-primary text-white">

<h3>

Ordenar Mediciones

</h3>

</div>

<div class="card-body">

<form action="/sort1" method="GET">

<div class="row">

<div class="col-md-4">

<label class="form-label">

Número de Parte

</label>

<select
id="numeroParte"
name="numeroParte"
class="form-select"
required>

<option value="">

Seleccione...

</option>

<% numerosParte.forEach(function(parte){ %>

<option
value="<%= parte %>"
<%= numeroParte==parte ? "selected" : "" %>>

<%= parte %>

</option>

<% }) %>

</select>

</div>

<div class="col-md-5">

<label class="form-label">

Característica

</label>

<select
id="campo"
name="campo"
class="form-select"
required>

<option value="">

Seleccione primero un número de parte

</option>

</select>

</div>

<div class="col-md-3 d-flex align-items-end">

<button
type="submit"
class="btn btn-primary w-100">

Buscar

</button>

</div>

</div>

</form>

<hr>

<div
id="spinner"
class="spinner text-center">

<div class="spinner-border text-primary"></div>

<br>

Cargando características...

</div>

<%

function obtenerValor(obj,path){

    return path
        .split(".")
        .reduce(
            (o,p)=>o ? o[p] : undefined,
            obj
        );

}

%>

<% if(resultados && resultados.length>0){ %>

<div class="mt-3">

<h5>

Resultados encontrados:
<span class="badge bg-success">

<%= resultados.length %>

</span>

</h5>

<table class="table table-bordered table-hover table-striped">

<thead class="table-dark">

<tr>

<th width="220">

Fecha

</th>

<th width="120">

Valor

</th>

<th width="120">

Editar

</th>

</tr>

</thead>

<tbody>
<% resultados.forEach(function(r){ %>

<%

const valor = obtenerValor(r, campo);

let clase = "";

if (valor !== undefined && valor !== null) {

    if (valor < 0) {

        clase = "table-danger";

    } else {

        clase = "";

    }

}

%>

<tr class="<%= clase %>">

    <td>

        <%= new Date(r.timestamp).toLocaleString("es-MX") %>

    </td>

    <td class="text-end">

        <% if(valor!==undefined && valor!==null){ %>

            <strong>

                <%= Number(valor).toFixed(3) %>

            </strong>

        <% }else{ %>

            --

        <% } %>

    </td>

    <td>

        <a

        href="/edit1/<%= r._id %>?campo=<%= encodeURIComponent(campo) %>"

        class="btn btn-warning btn-sm">

            Editar

        </a>

    </td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<% }else{ %>

<div class="alert alert-secondary mt-4">

No hay registros para mostrar.

</div>

<% } %>
<hr>

<div class="row">

<div class="col">

<small class="text-muted">

Sistema SPC - Ordenador de Mediciones

</small>

</div>

<div class="col text-end">

<small class="text-muted">

<%= new Date().toLocaleString("es-MX") %>

</small>

</div>

</div>

</div>

</div>

</div>

<script>

const comboParte = document.getElementById("numeroParte");
const comboCampo = document.getElementById("campo");
const spinner = document.getElementById("spinner");

const campoSeleccionado = "<%= campo || '' %>";

async function cargarCaracteristicas(){

    comboCampo.innerHTML="";

    if(comboParte.value===""){

        comboCampo.appendChild(
            new Option(
                "Seleccione primero un número de parte",
                ""
            )
        );

        return;

    }

    spinner.style.display="block";

    try{

        const respuesta = await fetch(
            "/caracteristicas/" +
            encodeURIComponent(comboParte.value)
        );

        if(!respuesta.ok){

            throw new Error("Error del servidor");

        }

        const lista = await respuesta.json();

        comboCampo.innerHTML="";

        comboCampo.appendChild(
            new Option(
                "Seleccione...",
                ""
            )
        );

        lista.forEach(c=>{

            comboCampo.appendChild(

                new Option(

                    c.nombre,

                    c.path

                )

            );

        });

        // Restaurar la característica seleccionada
        if(campoSeleccionado){

            comboCampo.value = campoSeleccionado;

        }

    }
    catch(error){

        console.error(error);

        comboCampo.innerHTML="";

        comboCampo.appendChild(

            new Option(

                "No fue posible cargar",

                ""

            )

        );

    }

    spinner.style.display="none";

}

comboParte.addEventListener("change", cargarCaracteristicas);

// Si la página ya trae un número de parte seleccionado,
// volver a cargar automáticamente las características.

if(comboParte.value){

    cargarCaracteristicas();

}

</script>

</script>

</body>

</html>